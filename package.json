{
  "name": "beatx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc -b --pretty false",
    "api:build": "node node_modules/typescript/bin/tsc -p tsconfig.api.json",
    "api:start": "node --env-file-if-exists=.env .api-dist/apps/api/src/server.js",
    "e2e:demo": "node node_modules/typescript/bin/tsc -p tsconfig.api.json && node tests/e2e-api.mjs",
    "e2e:solana": "node tests/e2e-solana.mjs",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.api.json && node --test tests/*.test.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@solana-mobile/wallet-standard-mobile": "^0.7.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "bn.js": "^5.2.1"
  }
}
