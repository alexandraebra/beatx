# BeatX runs in demo mode without secrets.
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://beatx:change-me@localhost:5432/beatx?schema=public
# Optional future intelligence provider; never commit a real key.
INTELLIGENCE_PROVIDER=deterministic
# Required for the local demo API. Generate a random value and keep it out of Git.
BEATX_RESOLVER_AUTHORITY=
BEATX_CORS_ORIGIN=http://localhost:5173
